    <script>
        window.onload = function () {
            setTimeout(function () {
                var modal = document.getElementById("md-agreement");
                modal.style.height = "auto";
                modal.style.padding = "1.5% 0";
            }, 10000);
        };
        

        $(document).ready(function () {
            checkCookie();
            $('#banner_site').slick({
                dots: true,
                slidesToShow: 1,
                slidesToScroll: 1,
                //infinite: false,
                autoplay: true,
                arrows: true,
                prevArrow: '<div class="next_arrow"></div>',
                nextArrow: '<div class="prev_arrow"></div>',
                autoplaySpeed: 5000,
                speed: 1000,

            });

            $('.banner_site').slick({
                dots: true,
                slidesToShow: 1,
                slidesToScroll: 1,
                //infinite: false,
                autoplay: true,
                arrows: true,
                prevArrow: '<div class="next_arrow"></div>',
                nextArrow: '<div class="prev_arrow"></div>',
                autoplaySpeed: 5000,
                speed: 1000,
                lazyLoad: 'ondemand',
            });
            $('.banner_site').on('afterChange', function(event, slick, currentSlide) {

                $(window).trigger('resize')

                $('.lazy').Lazy();
            });

            jQuery('.header-global__flyout__item .vehicle-selection .section_list-2 .item_car').width(jQuery('.header-global__flyout__item .vehicle-selection .section_list .item_car').width());
        });

        function showPopup() {
            var isHidePopup = sessionStorage.getItem("isHidePopup");
            if (isHidePopup == null || isHidePopup == undefined) {
                var delayTime = 5 * 1000;
                var displayTime = 3600 * 1000;

                setTimeout(function () {
                    $("#mazda-popup").fadeIn();
                    setTimeout(function () {
                        $("#mazda-popup").fadeOut();
                    }, displayTime);
                }, delayTime);
            }
        }

        function checkCountDisplayPopup() {
            var result = true;
            var countDisplay = sessionStorage.getItem('displayPopup');
            if (countDisplay > parseInt(1)) {
                result = false;
            }
            return result;
        }


        function diff_minutes(dt2, dt1) {
            var diff = (dt2.getTime() - dt1.getTime()) / 1000;
            diff /= 60;
            return Math.abs(Math.round(diff));
        }

        function checkTimeDisplayPopup() {
            var result = true;
            var timeDisplay = sessionStorage.getItem('timeClosePopup');
            if (timeDisplay) {
                let past = new Date(timeDisplay);
                let current = new Date();
                var minutes = diff_minutes(past, current);
                if (minutes < parseInt(1)) {
                    result = false;
                }
                console.log("calculated", diff_minutes(past, current));
            }
            return result;
        }

        function closePopup() {
            var count = sessionStorage.getItem('displayPopup');
            if (count) {
                var ind = parseInt(count) + 1;
                sessionStorage.setItem('displayPopup', ind);
            } else {
                sessionStorage.setItem('displayPopup', 1);
            }

            var d = new Date();
            d.setTime(d.getTime());
            sessionStorage.setItem('timeClosePopup', d.toUTCString());

        }

        function agreement() {
            //// set a new cookie
            //expiry = new Date();
            //expiry.setTime(expiry.getMonth() + 1);
            //// Date()'s toGMTSting() method will format the date correctly for a cookie
            //document.cookie = "cookies=agrement; expires=" + expiry.toGMTString();
            setCookie("username", "yes", 30);
        }

        function setCookie(cname, cvalue, exdays) {
            var d = new Date();
            d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
            var expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }

        function checkCookie() {
            console.log('checkCookie');
            var agrement = getCookie("username");
            if (agrement != "") {
                //$('#md-agreement').hide();
                $('#md-agreement').css('display', 'none');
            } else {
                //$('#md-agreement').show();
            }
        }

        function getCookie(cname) {
            var name = cname + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }

        function deleteAllCookies() {
            var cookies = document.cookie.split(";");
            for (var i = 0; i < cookies.length; i++) {
                var cookie = cookies[i];
                var eqPos = cookie.indexOf("=");
                var name = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
                document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (window.location.pathname.includes("/vehicles") ||
            window.location.pathname.includes("/promotion") ||
            window.location.pathname.includes("/news-and-events/news-and-events-content") ||
            window.location.pathname.includes("/offers/offers") ||
            window.location.pathname.includes("/tin-tuc/offers") ||
            window.location.pathname.includes("/contact-us") ||
            window.location.pathname.includes("/dich-vu") ||
            window.location.pathname.includes("/service")

            ) {
                const menuSecondMobile = document.getElementsByClassName("menu-secondary__row--mobile")[0];
                const bannerSiteMobile = document.getElementsByClassName("banner_site")[0];
                const headerglobalinnerwrapper = document.getElementsByClassName("header-global__inner-wrapper")[0];

                if (menuSecondMobile) {
                    menuSecondMobile.style.position = "fixed";
                    menuSecondMobile.style.top = "7%";
                }
                if (bannerSiteMobile && false) {
                    bannerSiteMobile.style.marginTop = "110px";
                }else{
                    bannerSiteMobile.style.marginTop= "72px";
                }
                if (headerglobalinnerwrapper) {

                    headerglobalinnerwrapper.addEventListener('mouseover', function() {
                        this.style.setProperty('background-color', '#fff', 'important');
                    });


                    headerglobalinnerwrapper.addEventListener('mouseout', function() {
                        this.style.backgroundColor = '';
                    });
                }
            }
        });

        window.addEventListener("scroll", function () {
            var modalCookie;
            var pageContainer = this.document.getElementsByClassName('page-container')[0];
            var heightHeader = 0;
            var heightSecondaryMenu = 0;
            var heightSecondaryMenuMobile = 0;
            var heightSticky = 0;
            if (this.document.getElementsByClassName("modal--cookie-agreement") != undefined) {
                modalCookie = this.document.getElementsByClassName("modal--cookie-agreement")[0];
            }
            var currentPosition = this.window.pageYOffset;
            var header = this.document.getElementById("globalHeaderSection");
            var sticky = this.document.getElementsByClassName('menu-secondary--sticky')[0];
            if (sticky != undefined) {
                heightSticky = sticky.offsetHeight;
            }
            heightHeader = header.offsetHeight;

            var menuSecondMobile;
            var menuSecondContainer;
            var secondaryMenu = this.document.getElementsByClassName("menu-secondary");
            if (secondaryMenu.length > 0) {
                menuSecondMobile = this.document.getElementsByClassName("menu-secondary__row--mobile")[0];
                menuSecondContainer = this.document.getElementsByClassName("menu-secondary__container")[0];
                heightSecondaryMenu = menuSecondContainer.offsetHeight;
                heightSecondaryMenuMobile = menuSecondMobile.offsetHeight;
            }

            if (currentPosition > modalCookie.clientHeight) {
                header.style.position = "fixed";
                header.style.zIndex = "9999";
                header.style.top = "0px";
                if (!window.matchMedia("(max-width: 1005px)").matches) {
                    pageContainer.style.paddingTop = heightHeader + heightSecondaryMenu - heightSticky + 'px';

                }
                else {
                    pageContainer.style.paddingTop = heightHeader + heightSecondaryMenuMobile - heightSticky + 'px';
                }

                //pageContainer.style.paddingTop = '128px';
                if (secondaryMenu.length > 0) {
                    menuSecondMobile.style.position = "fixed";
                    menuSecondMobile.style.zIndex = "990";
                    menuSecondMobile.style.width = "100%";
                   <!--menuSecondMobile.style.top = header.clientHeight + "px";-->
                    if (window.location.pathname.includes("/vehicles") ||
                    window.location.pathname.includes("/promotion") ||
                    window.location.pathname.includes("/news-and-events/news-and-events-content") ||
                    window.location.pathname.includes("/offers/offers") ||
                    window.location.pathname.includes("/tin-tuc/offers") ||
                    window.location.pathname.includes("/contact-us") ||
                    window.location.pathname.includes("/dich-vu") ||
                    window.location.pathname.includes("/service")
                    ) {
                        menuSecondMobile.style.top = "7%";
                    }else{
                        menuSecondMobile.style.top = header.clientHeight + "px";
                    }

                    menuSecondContainer.style.backgroundColor = "#ffffff";
                    menuSecondContainer.style.borderBottom = "1px solid #d5d5d5";
                    menuSecondContainer.style.position = "fixed";
                    menuSecondContainer.style.top = header.clientHeight + menuSecondMobile.clientHeight + "px";
                    if (!window.matchMedia("(max-width: 1005px)").matches) {
                        menuSecondContainer.style.width = "100%";
                        menuSecondContainer.style.zIndex = "99";

                    }
                }

            }
            else {
                header.style.position = "relative";
                header.style.top = "";
                pageContainer.style.paddingTop = '0px';
                                                                                                                                                                                                                              /*  $(".header-global__menu__upper").show*/;
                if (secondaryMenu.length > 0) {
                    menuSecondMobile.style.position = "relative";
                    menuSecondMobile.style.zIndex = "990";
                    <!--menuSecondMobile.style.top = "";-->
                    if (window.location.pathname.includes("/vehicles") ||
                    window.location.pathname.includes("/promotion") ||
                    window.location.pathname.includes("/news-and-events/news-and-events-content") ||
                    window.location.pathname.includes("/offers/offers") ||
                    window.location.pathname.includes("/tin-tuc/offers") ||
                    window.location.pathname.includes("/contact-us") ||
                    window.location.pathname.includes("/dich-vu") ||
                    window.location.pathname.includes("/service")
                    ) {
                        menuSecondMobile.style.position = "fixed";
                        menuSecondMobile.style.top = "7%";
                    }else{
                        menuSecondMobile.style.top = "";
                    }

                    if (window.matchMedia("(max-width: 1005px)").matches) {
                        menuSecondContainer.style.position = "absolute";
                        menuSecondContainer.style.top = "";
                    } else {
                        menuSecondContainer.style.position = "relative";
                        menuSecondContainer.style.top = "";
                    }
                }

            }
        });
    </script>



            <script>
                var isCountDisplayPopup = checkCountDisplayPopup();
                if (isCountDisplayPopup == true) {
                    var isTimeDisplayPopup = checkTimeDisplayPopup();
                    if (isTimeDisplayPopup) {
                        showPopup();
                    }
                }
            </script>
        <script src="https://mazdamotors.vn/assets/cx5/library/slick/slick/slick.js"></script>
    <script src="https://mazdamotors.vn/assets/cx5/library/aos/aos.js"></script>
    <script src="https://mazdamotors.vn/assets/cx5/library/fancybox/fancybox.js"></script>
    
    <script src="/scripts/swiper-bundle.min.js"></script>
    <script src="/scripts/jquery.lazy.min.js"></script>
    <script>$((function () { $(".lazy").lazy() }))</script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var footers = document.querySelectorAll('footer.footer[data-block="footer"]');
            if (footers.length > 1) {
                for (var i = 0; i < footers.length - 1; i++) {
                    footers[i].remove();
                }
            }
        });
    </script>
</body>

</html>
