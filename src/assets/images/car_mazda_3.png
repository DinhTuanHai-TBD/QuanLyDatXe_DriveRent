  }
  .sixty-forty--light .sixty-forty__content--disclaimerCopy,
  .sixty-forty--light .sixty-forty__content--mainTitle,
  .sixty-forty--light .sixty-forty__content--preTitle,
  .sixty-forty--light .sixty-forty__content--textCopy {
    color: #101010;
  }
