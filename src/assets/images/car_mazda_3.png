  }
  .shopping-tools__article {
    margin-bottom: 40px;
    width: 100%;
  }
  .shopping-tools__copy {
    display: none;
    padding-top: 0;
  }
  .shopping-tools__cta {
    padding-top: 0;
  }
  .shopping-tools__title {
    margin-bottom: 11px;
  }
}
.sitemap {
