  margin-bottom: 0;
}
.modal--lightbox {
  transition: opacity 0.35s cubic-bezier(0.645, 0.045, 0.355, 1),
    visibility 0s 0.25s, -webkit-transform 0s 0.25s;
  transition: opacity 0.35s cubic-bezier(0.645, 0.045, 0.355, 1),
    transform 0s 0.25s, visibility 0s 0.25s;
  transition: opacity 0.35s cubic-bezier(0.645, 0.045, 0.355, 1),
    transform 0s 0.25s, visibility 0s 0.25s, -webkit-transform 0s 0.25s;
}
.modal--lightbox.modal--open {
  opacity: 1;
  transition: opacity 0.35s cubic-bezier(0.645, 0.045, 0.355, 1);
}
.modal--lightbox.modal--50-50 .modal__container {
  align-items: center;
  height: 100vh;
