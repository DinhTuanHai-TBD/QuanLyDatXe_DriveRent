}
.shopping-tools__title {
  text-transform: uppercase;
  font-size: 82%;
  font-size: 0.8125rem;
  margin-bottom: 15px;
  letter-spacing: 0.2em;
  color: #101010;
  font-weight: 700;
  line-height: 2.3rem;
}
.shopping-tools__copy {
  font-size: 100%;
  font-size: 1rem;
  line-height: 1.5;
  letter-spacing: 0.01em;
  font-weight: 400;
  line-height: 1.75;
