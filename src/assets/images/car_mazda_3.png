}
.shopping-tools__header {
  text-align: center;
}
.shopping-tools__header-title {
  font-size: 1.25rem;
  line-height: 1.75;
  letter-spacing: 0.2em;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 30px;
