}

.popup_addcompare,
.popup_installment {
    position: fixed;
    width: 100%;
    height: 100%;
    z-index: 111;
    top: 0;
    left: 0;
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center
}

.popup_addcompare.showpopup,
.popup_installment.showpopup {
    display: flex
}

.popup_addcompare .overlay_area,
.popup_installment .overlay_area {
