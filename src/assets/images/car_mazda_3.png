    width: 17px;
    pointer-events: none;
  }
  .header-global__nav__list-item-link.mobile-menu-link
    .header-global__nav__mobile-menu-icon
    li {
    background-color: #999;
    display: block;
    height: 2px;
    margin: 0 0 2px;
    position: absolute;
    transition: top 0.1s ease-out 0.1s, opacity 0.1s ease-out 0.1s,
      -webkit-transform 0.1s ease-in 0s;
    transition: top 0.1s ease-out 0.1s, transform 0.1s ease-in 0s,
      opacity 0.1s ease-out 0.1s;
    transition: top 0.1s ease-out 0.1s, transform 0.1s ease-in 0s,
      opacity 0.1s ease-out 0.1s, -webkit-transform 0.1s ease-in 0s;
    width: 17px;
    margin: 8px 0 5px;
