}
body.is-rtl
  .bym__tout-carousel__tout.inactive-next:hover
  .bym__tout-carousel__inactive-overlay:after,
body.is-rtl
  .bym__tout-carousel__tout.inactive-next:hover
  .bym__tout-carousel__inactive-overlay:before {
