<script src="/scripts/lib/jquery.js"></script>
<script>
    //setTimeout(function () {
    //    chooseNav(26911, MediumSUV);
    //    chooseNav('all', 'all');
    //},200)
    $(document).ready(function () {
        setTimeout(function () {
            var el = $('.filter-vehicle').find('img.jimg-fluid');
            $(el).each(function (index) {
                $(this).attr("src", $(this).data("src"));
            });
        }, 300);
    })

    function chooseNav(id, dataid) {
        var current = document.getElementsByClassName("active");
        console.log('.');
        current[0].className = current[0].className.replace(" active", "");
        document.getElementById(id).className += " active"
        if (dataid !== "all") {
            dataid.style.borderBottom = "none"
        }

        for (let i = 0; i < document.getElementsByClassName("section_list").length - 1; i++) {
            if (dataid == "all") {
                //console.log(document.getElementsByClassName("section_list")[i])
                document.getElementsByClassName("section_list")[i].style.borderBottom = "1px solid #D0CECF"
            }
        }
        document.getElementById(id).scrollIntoView();
    }
</script>            </div>
