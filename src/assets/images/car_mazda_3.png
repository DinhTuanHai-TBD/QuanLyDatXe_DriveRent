.modal {
  bottom: 0;
  height: 100%;
  left: 0;
  max-height: 100vh;
  opacity: 0;
  overflow: hidden;
  position: fixed;
  right: 0;
  top: 0;
  visibility: hidden;
  width: 100%;
  z-index: 99999;
}
.modal__container {
  display: block;
  height: 100%;
  left: 0;
  position: fixed;
  width: 100%;
  background-color: #f5f5f5;
  overflow-y: auto;
  padding: 60px 20px;
  top: 50%;
  text-align: center;
  -webkit-transform: translate3d(0, -50%, 0);
  transform: translate3d(0, -50%, 0);
  -webkit-overflow-scrolling: touch;
}
.modal__copy__content--open-html {
