.shopping-tools {
  padding: 35px 0 40px;
}
.shopping-tools--light .shopping-tools__copy,
.shopping-tools--light .shopping-tools__header-sub-title,
.shopping-tools--light .shopping-tools__header-title,
.shopping-tools--light .shopping-tools__title {
