@media (max-width:567px) {
    .iscomming {
        margin-bottom: 40px
    }
}

@media (min-width:768px) {
    .jcol-md-12-custom-5inrow {
        -ms-flex: 0 0 100%;
        flex: 0 0 100%;
        max-width: 100%;
        position: relative;
        padding-right: 15px;
        padding-left: 15px;
        margin-left: 45px
    }

    .jcol-md-5inrow-custom-item {
        -ms-flex: 0 0 20%;
        flex: 0 0 20%;
        max-width: 20%;
        position: relative
    }
}

