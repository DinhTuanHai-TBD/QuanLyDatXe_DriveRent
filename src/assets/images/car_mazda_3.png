  margin-bottom: 20px;
}
.shopping-tools__cta {
  padding: 10px 0;
}
@media (min-width: 1200px) {
  .shopping-tools__inner-wrapper:hover .shopping-tools__link {
    opacity: 0.5;
  }
  .shopping-tools__inner-wrapper:hover .shopping-tools__link:hover {
    opacity: 1;
  }
  .shopping-tools__link:hover .shopping-tools__cta span {
