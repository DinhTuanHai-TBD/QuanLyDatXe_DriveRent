.footer {
  height: auto;
  position: relative;
  font-size: 1rem;
  line-height: 1.3rem;
}
.footer__row {
  margin: 10px 0;
}
.footer__social-row {
  margin-top: 30px;
}
.footer__register-input {
  width: 80%;
  height: 2rem;
  font-size: 1.2rem;
  background-color: #000;
  outline: 0;
  border: none;
  color: #fff;
  padding: 0 10px;
  border-radius: 2px;
}
.footer__register-button {
  background-color: #fff;
  padding: 5px 20px;
  font-size: 1.2rem;
  border-radius: 2px;
}
.footer__row .quick__link {
  text-decoration: none;
}
.footer__row .quick__link:hover {
  font-weight: 700;
}
.license-img {
  width: 150px;
}
a.quick__link {
  color: #999;
}
.footer-wrapper {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  overflow: hidden;
  display: flex;
  flex-wrap: wrap;
}
.footer__copyright {
  text-align: left;
}
.footer-wrapper .footer__component {
  margin-top: 20px;
  padding: 0 15px;
}
.main-component {
  width: calc(100% / 3);
}
.sub-component {
  width: calc(200% / 9);
}
.sub-component-hcm {
  width: 20%;
}
.sub-component-hcm-2 {
  width: calc(80% / 3);
}
.footer-logo {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 0 20px;
}
.footer__logo {
  width: auto;
  height: 50px;
  object-fit: contain;
  font-size: 12px;
  object-position: center;
}
.footer__component .social-link {
  color: #fff;
  text-decoration: none;
}
.footer__component .social-link .social-img {
  width: 13%;
  margin: 0 3% 0 0;
  border-radius: 50%;
}
.footer__p {
  font-size: 12px;
  font-weight: 300;
  color: #999;
}
span.footer__p.p_title {
  font-weight: 700;
  font-size: 14px;
  color: #fff;
}
@media only screen and (max-width: 959px) {
  .footer-logo .footer__logo {
    width: 10%;
  }
  .footer-wrapper .footer__component {
    padding: 0;
  }
}
@media only screen and (max-width: 500px) {
  .footer-wrapper {
